        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/agent-learn.mjs\"",
        "commandWindows": "node \"%PLUGIN_ROOT%/hooks/agent-learn.mjs\"",
        "timeout": 10
      }]
    }]
  }
}
